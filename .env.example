# ====================================================================
# Gajae Code App Docker Configuration
# ====================================================================

# Port to expose on the host machine
SERVER_PORT=3001

# Allowed hostnames/origins (* permits all hosts, or specify comma-separated domains)
ALLOWED_HOSTS=*

# Host directory to mount as /workspace inside the container
# Point this to your local code projects folder, e.g., ~/Projects or ./workspace
HOST_WORKSPACE_DIR=./workspace

# Application source compiled into the image. `main` follows the latest commit
# in this fork whenever you rebuild without Docker's cache.
APP_REPOSITORY=https://github.com/websterwh/gajae-code-app.git
APP_REF=main

# ====================================================================
# Universal Addon Packages (Comma-Separated)
# ====================================================================
# Debian packages to install via apt-get (e.g. openjdk-17-jre-headless,ffmpeg)
APT_PACKAGES=

# Standalone Python CLI tools / MCP servers installed via `uv tool install`
# (e.g. serena,canvas-mcp-server)
UV_TOOLS=

# Python packages installed globally via `uv pip install --system`
# (e.g. requests,cryptography)
PIP_PACKAGES=

# GitHub release CLI binaries installed via Aqua (Obtainium for CLI)
# (e.g. skylot/jadx,iBotPeaches/Apktool)
GITHUB_APPS=

# Automatic package update options
AUTO_UPDATE_PACKAGES=true
CHECK_PACKAGE_UPDATES=true

# Custom shell commands executed after provisioning (e.g. adb connect 192.168.1.79:5555)
POST_COMMANDS=
# ====================================================================
# Direct Container SSH & CLI Access
# ====================================================================
# Enable SSH daemon inside the container
SSH_ENABLE=false
SSH_PORT=2222

# Password authentication
SSH_ALLOW_PASSWORD=false
SSH_PASSWORD=

# Public keys (paste literal public key, comma-separated keys, or https://... URL)
SSH_PUBLIC_KEYS=

# Allow passwordless & keyless direct login (convenient for local private networks)
SSH_NO_AUTH=false

# Optional command executed on interactive SSH login (leave blank for standard bash shell)
SSH_DEFAULT_COMMAND=
# Install/link standalone gjc CLI binary to /data/bin/gjc
INSTALL_GJC_CLI=true

# ====================================================================
# Optional AI Provider API Keys
# ====================================================================
# You can set these here or enter them via /login in the Web UI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
