# ====================================================================
# Gajae Code App Docker Configuration
# ====================================================================

# Port to expose on the host machine
SERVER_PORT=3001

# Allowed hostnames/origins (* permits all hosts, or specify comma-separated domains)
ALLOWED_HOSTS=*

# Host directory to mount as /workspace inside the container
# Point this to your local code projects folder, e.g., ~/Projects or ./workspace
HOST_WORKSPACE_DIR=./workspace

# In-Container Automatic Updates
# Set to 'true' to check for updates directly from GitHub on container start
AUTO_UPDATE=true

# Periodic update check interval in seconds while running
# 0 = only check on container start / restart
# 21600 = check every 6 hours and hot-restart server when an update drops
UPDATE_INTERVAL=0

# Target upstream version (use 'latest' or a specific tag like 'v2.0.0-beta.20')
VERSION=latest

# Optional AI Provider API Keys
# You can set these here or enter them via Settings in the Web UI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
